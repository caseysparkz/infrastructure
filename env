# Description:  Set required environment variables.
# Usage:        `source ./env`
# To do:        Write in error handling.

unset _EXPERIMENTAL_DAGGER_RUNNER_HOST

load_aws() {
    if which aws > /dev/null 2>&1; then  # Check AWS CLI installed
        if ! aws sts get-caller-identity > /dev/null 2>&1; then
            printf 'Logging in to AWS.\n'
            aws sso login
        fi
    else
        printf 'AWS CLI not installed.\n'
        exit 1
    fi

    printf 'Setting AWS environment variables.\n'
    printf '* AWS_ACCESS_KEY_ID\n'
    printf '* AWS_SECRET_ACCESS_KEY\n'
    printf '* AWS_SESSION_TOKEN\n'
    printf '* AWS_CREDENTIAL_EXPIRATION\n'

    unset AWS_ACCESS_KEY_ID
    unset AWS_SECRET_ACCESS_KEY
    unset AWS_SESSION_TOKEN
    unset AWS_CREDENTIAL_EXPIRATION

    eval "$(aws configure export-credentials --format env)"

    export AWS_ACCESS_KEY_ID
    export AWS_SECRET_ACCESS_KEY
    export AWS_SESSION_TOKEN
    export AWS_CREDENTIAL_EXPIRATION

    printf 'Done.\n\n'
}

load_github() {
    if which gh > /dev/null 2>&1; then  # Check AWS CLI installed
        if ! gh auth token > /dev/null 2>&1; then
            printf 'Logging in to GitHub CLI.\n'
            gh auth login
        fi
    else
        printf 'GitHub CLI not installed.\n'
        exit 1
    fi

    printf 'Setting GitHub environment variables.\n'
    printf '* GITHUB_TOKEN\n'

    unset GITHUB_TOKEN

    GITHUB_TOKEN="$(gh auth token)"

    export GITHUB_TOKEN

    printf 'Done.\n\n'
}

setup_kubernetes_environment() {
    if ! which helm > /dev/null 2>&1; then
        printf 'Helm not installed.\n'
        exit 1
    fi

    if ! which kubectl > /dev/null 2>&1; then
        printf 'kubectl not installed.\n'
        exit 1
    fi

    local DAGGER_ENGINE_POD_NAME

    printf 'Setting up dagger namespace.\n'

    helm upgrade                                                            \
        --install                                                           \
        --namespace=dagger                                                  \
        --create-namespace                                                  \
        dagger                                                              \
        oci://registry.dagger.io/dagger-helm

    kubectl wait                                                            \
        --for condition=Ready                                               \
        --timeout=60s                                                       \
        pod                                                                 \
        --selector=name=dagger-dagger-helm-engine                           \
        --namespace=dagger

    DAGGER_ENGINE_POD_NAME="$(kubectl get pod                               \
        --selector=name=dagger-dagger-helm-engine                           \
        --namespace=dagger                                                  \
        --output=jsonpath='{.items[0].metadata.name}'                       \
    )"

    _EXPERIMENTAL_DAGGER_RUNNER_HOST="kube-pod://${DAGGER_ENGINE_POD_NAME}?namespace=dagger"

    export _EXPERIMENTAL_DAGGER_RUNNER_HOST
}


load_aws
load_github

if [[ "${1:-}" == '--kubernetes' ]]; then setup_kubernetes_environment; fi

printf 'Environment is ready.\n'
